# Django / Railway
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://dealer-frontend.example.com
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSLMODE=require
MARKETPLACE_WEBHOOK_URL=https://marketplace.example.com/integrations/v1/events
MARKETPLACE_WEBHOOK_SECRET=replace-with-a-separate-shared-secret
# Cloudflare R2 / S3-compatible media (omit all for local filesystem storage)
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=dealer-media
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.example.com
# Public media/API origin used when serializing object URLs
PUBLIC_API_URL=https://api.example.com
# Next.js / Vercel
NEXT_PUBLIC_API_URL=https://api.example.com
API_INTERNAL_URL=https://api.example.com
# Local/demo only; omit in production so the incoming custom hostname is used.
DEALER_HOST_OVERRIDE=
